table _Measures
	lineageTag: 7f656591-983c-483d-9bb1-727267104cb4

	measure Headcount = COUNTROWS ( Employees )
		formatString: #,0
		displayFolder: Core
		lineageTag: 089e5861-bd4d-4f01-bf99-9088a593196d

	measure Leavers = CALCULATE ( [Headcount], Employees[Attrition] = "Yes" )
		formatString: #,0
		displayFolder: Core
		lineageTag: 73d8d3cf-5240-40b3-bb97-6f7704597d90

	measure 'Active Employees' = CALCULATE ( [Headcount], Employees[Attrition] = "No" )
		formatString: #,0
		displayFolder: Core
		lineageTag: cfa81a72-8640-4e7a-a58b-bdc53f554e26

	measure 'Attrition Rate' = DIVIDE ( [Leavers], [Headcount] )
		formatString: 0.0%
		displayFolder: Core
		lineageTag: 5be6a230-314e-449b-ad52-da0e8cfb3831

	measure 'Baseline Attrition Rate' =
			// Attrition across everything currently selected (ignores the visual's own grouping)
			CALCULATE ( [Attrition Rate], ALLSELECTED ( Employees ) )
		formatString: 0.0%
		displayFolder: Core
		lineageTag: 7920c553-292a-422c-9e9e-8a1ed4fdcc1d

	measure 'Attrition vs Average' = DIVIDE ( [Attrition Rate], [Baseline Attrition Rate] )
		formatString: 0.00
		displayFolder: Core
		lineageTag: 1cefa10d-2e37-4c2d-be1e-6392fc3e0f0c

	measure 'Avg Age' = AVERAGE ( Employees[Age] )
		formatString: 0.0
