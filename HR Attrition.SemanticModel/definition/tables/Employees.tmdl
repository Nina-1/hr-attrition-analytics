		sourceColumn: Risk Tier Order

		annotation SummarizationSetBy = Automatic

	partition Employees = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\HR_Analytics Data Set.csv"), [Delimiter = ",", Columns = 38, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    BlankManager = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"YearsWithCurrManager"}),
				    Typed = Table.TransformColumnTypes(BlankManager, {{"EmpID", type text}, {"Age", Int64.Type}, {"AgeGroup", type text}, {"Attrition", type text}, {"BusinessTravel", type text}, {"Department", type text}, {"DistanceFromHome", Int64.Type}, {"Education", Int64.Type}, {"EducationField", type text}, {"EmployeeNumber", Int64.Type}, {"EnvironmentSatisfaction", Int64.Type}, {"Gender", type text}, {"JobInvolvement", Int64.Type}, {"JobLevel", Int64.Type}, {"JobRole", type text}, {"JobSatisfaction", Int64.Type}, {"MaritalStatus", type text}, {"MonthlyIncome", Int64.Type}, {"SalarySlab", type text}, {"NumCompaniesWorked", Int64.Type}, {"OverTime", type text}, {"PercentSalaryHike", Int64.Type}, {"PerformanceRating", Int64.Type}, {"RelationshipSatisfaction", Int64.Type}, {"StockOptionLevel", Int64.Type}, {"TotalWorkingYears", Int64.Type}, {"TrainingTimesLastYear", Int64.Type}, {"WorkLifeBalance", Int64.Type}, {"YearsAtCompany", Int64.Type}, {"YearsInCurrentRole", Int64.Type}, {"YearsSinceLastPromotion", Int64.Type}, {"YearsWithCurrManager", Int64.Type}}),
				    // 10 employees appear twice in the source extract; keep the first record per EmpID
				    Deduped = Table.Distinct(Table.Buffer(Typed), {"EmpID"}),
				    Cleaned = Table.TransformColumns(Deduped, {
				        {"BusinessTravel", each if _ = "Travel_Rarely" or _ = "TravelRarely" then "Travel Rarely" else if _ = "Travel_Frequently" then "Travel Frequently" else _, type text},
				        {"SalarySlab", each if _ = "Upto 5k" then "Up to 5k" else _, type text}}),
				    Renamed = Table.RenameColumns(Cleaned, {{"EmpID", "Employee ID"}, {"AgeGroup", "Age Group"}, {"BusinessTravel", "Business Travel"}, {"DistanceFromHome", "Distance From Home"}, {"EducationField", "Education Field"}, {"EmployeeNumber", "Employee Number"}, {"EnvironmentSatisfaction", "Environment Satisfaction"}, {"JobInvolvement", "Job Involvement"}, {"JobLevel", "Job Level"}, {"JobRole", "Job Role"}, {"JobSatisfaction", "Job Satisfaction"}, {"MaritalStatus", "Marital Status"}, {"MonthlyIncome", "Monthly Income"}, {"SalarySlab", "Salary Slab"}, {"NumCompaniesWorked", "Companies Worked"}, {"OverTime", "Overtime"}, {"PercentSalaryHike", "Salary Hike %"}, {"PerformanceRating", "Performance Rating"}, {"RelationshipSatisfaction", "Relationship Satisfaction"}, {"StockOptionLevel", "Stock Option Level"}, {"TotalWorkingYears", "Total Working Years"}, {"TrainingTimesLastYear", "Trainings Last Year"}, {"WorkLifeBalance", "Work-Life Balance"}, {"YearsAtCompany", "Years at Company"}, {"YearsInCurrentRole", "Years in Current Role"}, {"YearsSinceLastPromotion", "Years Since Promotion"}, {"YearsWithCurrManager", "Years with Manager"}}),
				    AddStatus = Table.AddColumn(Renamed, "Status", each if [Attrition] = "Yes" then "Left" else "Stayed", type text),
				    AddFlag = Table.AddColumn(AddStatus, "Attrition Flag", each if [Attrition] = "Yes" then 1 else 0, Int64.Type),
				    AddLevel = Table.AddColumn(AddFlag, "Job Level Label", each "Level " & Text.From([Job Level]), type text),
				    AddEdu = Table.AddColumn(AddLevel, "Education Level", each {"Below College", "College", "Bachelor", "Master", "Doctor"}{[Education] - 1}, type text),
				    AddJobSat = Table.AddColumn(AddEdu, "Job Satisfaction Level", each {"Low", "Medium", "High", "Very High"}{[Job Satisfaction] - 1}, type text),
				    AddEnvSat = Table.AddColumn(AddJobSat, "Environment Satisfaction Level", each {"Low", "Medium", "High", "Very High"}{[Environment Satisfaction] - 1}, type text),
				    AddRelSat = Table.AddColumn(AddEnvSat, "Relationship Satisfaction Level", each {"Low", "Medium", "High", "Very High"}{[Relationship Satisfaction] - 1}, type text),
				    AddInvolve = Table.AddColumn(AddRelSat, "Job Involvement Level", each {"Low", "Medium", "High", "Very High"}{[Job Involvement] - 1}, type text),
				    AddWlb = Table.AddColumn(AddInvolve, "Work-Life Balance Level", each {"Bad", "Good", "Better", "Best"}{[#"Work-Life Balance"] - 1}, type text),
				    AddStock = Table.AddColumn(AddWlb, "Stock Options", each {"None", "Low", "Medium", "High"}{[Stock Option Level]}, type text),
				    AddTenure = Table.AddColumn(AddStock, "Tenure Band", each if [Years at Company] < 1 then "<1 yr" else if [Years at Company] <= 2 then "1-2 yrs" else if [Years at Company] <= 5 then "3-5 yrs" else if [Years at Company] <= 10 then "6-10 yrs" else "10+ yrs", type text),
				    AddRole = Table.AddColumn(AddTenure, "Years in Role Band", each if [Years in Current Role] <= 1 then "0-1 yrs" else if [Years in Current Role] <= 4 then "2-4 yrs" else "5+ yrs", type text),
				    AddManager = Table.AddColumn(AddRole, "Manager Tenure Band", each if [Years with Manager] = null then "Unknown" else if [Years with Manager] <= 1 then "0-1 yrs" else if [Years with Manager] <= 4 then "2-4 yrs" else "5+ yrs", type text),
				    AddPromo = Table.AddColumn(AddManager, "Promotion Gap Band", each if [Years Since Promotion] <= 1 then "0-1 yrs" else if [Years Since Promotion] <= 4 then "2-4 yrs" else if [Years Since Promotion] <= 7 then "5-7 yrs" else "8+ yrs", type text),
				    AddDistance = Table.AddColumn(AddPromo, "Distance Band", each if [Distance From Home] <= 5 then "0-5" else if [Distance From Home] <= 10 then "6-10" else if [Distance From Home] <= 20 then "11-20" else "21+", type text),
				    AddTenureYear = Table.AddColumn(AddDistance, "Tenure Year", each if [Years at Company] >= 20 then "20+" else Text.From([Years at Company]), type text),
				    AddTenureYearOrder = Table.AddColumn(AddTenureYear, "Tenure Year Order", each List.Min({[Years at Company], 20}), Int64.Type),
				    AddPrior = Table.AddColumn(AddTenureYearOrder, "Prior Companies Band", each if [Companies Worked] <= 1 then "0-1 companies" else if [Companies Worked] <= 4 then "2-4 companies" else "5+ companies", type text),
				    AddOrders = List.Accumulate(
				        {
				            {"Age Group", {"18-25", "26-35", "36-45", "46-55", "55+"}},
				            {"Business Travel", {"Non-Travel", "Travel Rarely", "Travel Frequently"}},
				            {"Salary Slab", {"Up to 5k", "5k-10k", "10k-15k", "15k+"}},
				            {"Tenure Band", {"<1 yr", "1-2 yrs", "3-5 yrs", "6-10 yrs", "10+ yrs"}},
				            {"Years in Role Band", {"0-1 yrs", "2-4 yrs", "5+ yrs"}},
				            {"Manager Tenure Band", {"0-1 yrs", "2-4 yrs", "5+ yrs", "Unknown"}},
				            {"Promotion Gap Band", {"0-1 yrs", "2-4 yrs", "5-7 yrs", "8+ yrs"}},
				            {"Distance Band", {"0-5", "6-10", "11-20", "21+"}},
				            {"Prior Companies Band", {"0-1 companies", "2-4 companies", "5+ companies"}}
				        },
				        AddPrior,
				        (t, spec) => Table.AddColumn(t, spec{0} & " Order", (r) => List.PositionOf(spec{1}, Record.Field(r, spec{0})) + 1, Int64.Type)),
				    // Risk index: one point per historically high-attrition attribute
				    AddFactors = Table.AddColumn(AddOrders, "Risk Factors", each Text.Combine(List.RemoveNulls({
				        if [Overtime] = "Yes" then "Overtime" else null,
				        if [Job Level] = 1 then "Entry level" else null,
				        if [Marital Status] = "Single" then "Single" else null,
				        if [Years at Company] <= 2 then "Tenure 2 yrs or less" else null,
				        if [Job Satisfaction] = 1 then "Low job satisfaction" else null,
				        if [Environment Satisfaction] = 1 then "Low environment satisfaction" else null,
				        if [#"Work-Life Balance"] = 1 then "Poor work-life balance" else null,
				        if [Business Travel] = "Travel Frequently" then "Frequent travel" else null,
				        if [Stock Option Level] = 0 then "No stock options" else null,
				        if [Age] <= 25 then "Age 25 or under" else null}), " · "), type text),
				    AddScore = Table.AddColumn(AddFactors, "Risk Score", each if [Risk Factors] = "" then 0 else List.Count(Text.Split([Risk Factors], " · ")), Int64.Type),
				    AddTier = Table.AddColumn(AddScore, "Risk Tier", each if [Risk Score] >= 5 then "Critical" else if [Risk Score] = 4 then "High" else if [Risk Score] = 3 then "Elevated" else "Low", type text),
				    AddTierOrder = Table.AddColumn(AddTier, "Risk Tier Order", each List.PositionOf({"Low", "Elevated", "High", "Critical"}, [Risk Tier]) + 1, Int64.Type),
				    Result = Table.SelectColumns(AddTierOrder, {"Employee ID", "Employee Number", "Age", "Age Group", "Attrition", "Status", "Attrition Flag", "Business Travel", "Department", "Distance From Home", "Distance Band", "Education", "Education Level", "Education Field", "Environment Satisfaction", "Environment Satisfaction Level", "Gender", "Job Involvement", "Job Involvement Level", "Job Level", "Job Level Label", "Job Role", "Job Satisfaction", "Job Satisfaction Level", "Marital Status", "Monthly Income", "Salary Slab", "Companies Worked", "Prior Companies Band", "Overtime", "Salary Hike %", "Performance Rating", "Relationship Satisfaction", "Relationship Satisfaction Level", "Stock Option Level", "Stock Options", "Total Working Years", "Trainings Last Year", "Work-Life Balance", "Work-Life Balance Level", "Years at Company", "Tenure Year", "Tenure Year Order", "Tenure Band", "Years in Current Role", "Years in Role Band", "Years Since Promotion", "Promotion Gap Band", "Years with Manager", "Manager Tenure Band", "Risk Factors", "Risk Score", "Risk Tier", "Age Group Order", "Business Travel Order", "Salary Slab Order", "Tenure Band Order", "Years in Role Band Order", "Manager Tenure Band Order", "Promotion Gap Band Order", "Distance Band Order", "Prior Companies Band Order", "Risk Tier Order"})
				in
				    Result

	annotation PBI_ResultType = Table

